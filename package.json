{
  "name": "arbiter",
  "version": "0.1.0",
  "description": "An express.js middleware that requires the client and server to play chess before continuing.",
  "keywords": [
    "middleware",
    "express",
    "chess"
  ],
  "homepage": "https://github.com/ZombieNW/Arbiter#readme",
  "bugs": {
    "url": "https://github.com/ZombieNW/Arbiter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZombieNW/Arbiter.git"
  },
  "license": "MIT",
  "author": "ZombieNW",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
